{
  "rewrites": [
    {
      "source": "/api/calendar/speranta.ics",
      "destination": "/api/speranta-cal"
    },
    {
      "source": "/api/calendar/tvhouse.ics",
      "destination": "/api/tvhouse-cal"
    },
    {
      "source": "/api/calendar/:token",
      "destination": "/api/calendar/[token]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/domestic.html",
      "destination": "/demo/domestic.html"
    },
    {
      "source": "/domestic",
      "destination": "/demo/domestic.html"
    },
    {
      "source": "/outside-cleaner.html",
      "destination": "/demo/outside-cleaner.html"
    },
    {
      "source": "/outside-cleaner",
      "destination": "/demo/outside-cleaner.html"
    },
    {
      "source": "/speranta-cleaning-guide.pdf",
      "destination": "/demo/guides/speranta-cleaning-guide.pdf"
    },
    {
      "source": "/welcome",
      "destination": "/demo/welcome.html"
    },
    {
      "source": "/signup",
      "destination": "/demo/welcome.html"
    },
    {
      "source": "/pricing",
      "destination": "/demo/welcome.html"
    },
    {
      "source": "/manifest.json",
      "destination": "/demo/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/demo/sw.js"
    },
    {
      "source": "/icons/(.*)",
      "destination": "/demo/icons/$1"
    },
    {
      "source": "/hep-manifest.json",
      "destination": "/demo/hep-manifest.json"
    },
    {
      "source": "/(.*)",
      "destination": "/demo/index_fixed.html"
    }
  ]
}
